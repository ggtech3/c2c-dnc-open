<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\C2CDnc.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>C2CDncOpenPreview</AssemblyName>
    <RootNamespace>WindowsDnc</RootNamespace>
    <AssemblyTitle>C2C DNC Open Preview</AssemblyTitle>
    <Product>C2C DNC Open Preview</Product>
    <Description>RS-232 CNC program sender and receiver</Description>
    <Version>0.9.8-open-preview.1</Version>
    <AssemblyVersion>0.9.8.1</AssemblyVersion>
    <FileVersion>0.9.8.1</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\community-configurations.json" LogicalName="C2CDnc.CommunityConfigurations.json" />
    <EmbeddedResource Include="Assets\C2CDnc-logo-dark.png" LogicalName="C2CDnc.LogoDark.png" />
    <EmbeddedResource Include="Assets\C2CDnc-logo-light.png" LogicalName="C2CDnc.LogoLight.png" />
  </ItemGroup>
</Project>
